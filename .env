LOG_LEVEL=debug
LOG_DIR=data/logs
LOG_RETENTION_DAYS=7
LOG_CONSOLE=true

# Cấu hình crawler TikTok
CRAWL_TIKTOK_ENABLED=true
CRAWL_INTERVAL_MS=600000
CRAWL_LIMIT=10
VIDEO_DOWNLOAD_DIR=data/videos/raw
MAX_POSTS_PER_VIDEO=1

TIKTOK_SEED_URLS=https://www.tiktok.com/@vtvcab.congnghe.onlive,https://www.tiktok.com/@anhem.news
#FB_SEED_URLS=https://www.facebook.com/Kenhtuyensinh.Video/videos,https://www.facebook.com/haihuochat.vn/videos,https://www.facebook.com/eyeplus.reels/reels

TIKTOK_BROWSER=chrome

DOWNLOAD_TIMEOUT_MS=300000
COMPRESS_TIMEOUT_MS=600000


FFMPEG_PATH=D:\ffmpeg\bin\ffmpeg.exe
FFPROBE_PATH=D:\ffmpeg\bin\ffprobe.exe
