{
  "name": "tiktoke-crawler1",
  "version": "1.0.0",
  "description": "Standalone TikTok Crawler for AutoEric project",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:dev": "ts-node src/index.ts",
    "start:prod": "node dist/index.js",
    "dev": "ts-node-dev --respawn src/index.ts",
    "pm2:start": "pm2 start ecosystem.config.cjs --only tiktoke-crawler1",
    "pm2:restart": "pm2 restart tiktoke-crawler1",
    "pm2:stop": "pm2 stop tiktoke-crawler1",
    "pm2:delete": "pm2 delete tiktoke-crawler1",
    "pm2:logs": "pm2 logs tiktoke-crawler1"
  },
  "dependencies": {
    "axios": "^1.6.2",
    "dotenv": "^16.3.1",
    "fluent-ffmpeg": "^2.1.3",
    "mysql2": "^3.6.5",
    "pino": "^10.3.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/node": "^20.10.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
